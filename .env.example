# Copiar como .env en el servidor y completar. NUNCA subir el .env a GitHub.

# Dirección pública del CRM
PUBLIC_URL=https://crm.gimnasioelclub.com.ar

# Base de datos (contraseña larga y aleatoria: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Primer usuario admin (solo se usa si todavía no hay usuarios)
ADMIN_USERNAME=leandro
ADMIN_NAME=Leandro Muñoz
ADMIN_PASSWORD=

# WhatsApp (Meta)
WHATSAPP_ACCESS_TOKEN=          # token permanente del usuario del sistema "ElClub API"
WHATSAPP_APP_SECRET=            # Meta for Developers → app "EL Club - Comunicacion" → Configuración → Básica → Clave secreta (sirve también para Instagram)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=  # texto inventado (openssl rand -hex 16); se pega también en Meta al configurar los webhooks (WhatsApp e Instagram)

# Instagram (mensajes directos)
INSTAGRAM_ACCESS_TOKEN=         # token de la página de Facebook de El Club, obtenido con el usuario del sistema (no vence)

# Conexión con la app de El Club (opcional, para la ficha del socio)
MAIN_APP_URL=https://app.gimnasioelclub.com.ar
MAIN_APP_TOKEN=

# Asistente (Claude). Clave de console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                 # opcional; por defecto claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=            # opcional; por defecto claude-haiku-5-5 para preguntas simples ("off" lo desactiva)
